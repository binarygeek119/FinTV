# POSTGRES_* is optional. Leave these unset to configure PostgreSQL in the web UI
# on first launch (saved as database.json under CHANNELFLOW_CONFIG). Docker /
# Unraid can still set POSTGRES_HOST and the rest; those win over the file.
# POSTGRES_HOST=127.0.0.1
# Local `scripts/dev.sh` uses podman Postgres on 5433 (host 5432 is often already taken).
# POSTGRES_PORT=5432
# POSTGRES_DB=fintv
# POSTGRES_USER=fintv
# POSTGRES_PASSWORD=fintv
JELLYFIN_URL=http://127.0.0.1:8096
TZ=America/Chicago
PORT=8097
CHANNELFLOW_PUBLIC_URL=
CHANNELFLOW_PATH_BASE=
CHANNELFLOW_LOG_DIR=
CHANNELFLOW_CONFIG=
FFMPEG_PATH=
CHANNELFLOW_YTDLP_PATH=
FFMPEG_HWACCEL=vaapi
FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128
