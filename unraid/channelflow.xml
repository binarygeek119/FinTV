<?xml version="1.0"?>
<Container version="2">
  <Name>ChannelFlow</Name>
  <Repository>ghcr.io/flowmeadow01/channelflow:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/FlowMeadow01/ChannelFlow</Support>
  <Project>https://github.com/FlowMeadow01/ChannelFlow</Project>
  <Overview>ChannelFlow — simulated live TV channels, EPG, commercials, WeatherStar, and news for Jellyfin. Pair with the ChannelFlow plugin. Point POSTGRES_* at your existing PostgreSQL instance on the same Docker network.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8097]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/FlowMeadow01/ChannelFlow/master/unraid/channelflow.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/FlowMeadow01/ChannelFlow/master/logo.png</Icon>
  <Config Name="Web UI" Target="8097" Default="8097" Mode="tcp" Description="Web UI, admin API, M3U/XMLTV/stream" Type="Port" Display="always" Required="true" Mask="false">8097</Config>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/channelflow" Mode="rw" Description="Logos, caches, weather/news working files" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/channelflow</Config>
  <Config Name="Media" Target="/media" Default="/mnt/user/media" Mode="rw" Description="Same library share Jellyfin uses" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media</Config>
  <Config Name="Intel GPU" Target="" Default="" Mode="" Description="Pass /dev/dri for Intel VAAPI encode and decode" Type="Device" Display="always" Required="false" Mask="false">/dev/dri</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="TZ" Target="TZ" Default="America/Chicago" Mode="" Description="Timezone" Type="Variable" Display="always" Required="false" Mask="false">America/Chicago</Config>
  <Config Name="Jellyfin URL" Target="JELLYFIN_URL" Default="http://Jellyfin:8096" Mode="" Description="Jellyfin base URL on the shared Docker network" Type="Variable" Display="always" Required="false" Mask="false">http://Jellyfin:8096</Config>
  <Config Name="Postgres Host" Target="POSTGRES_HOST" Default="postgres" Mode="" Description="PostgreSQL hostname on the Docker network" Type="Variable" Display="always" Required="true" Mask="false">postgres</Config>
  <Config Name="Postgres Port" Target="POSTGRES_PORT" Default="5432" Mode="" Description="PostgreSQL port" Type="Variable" Display="advanced" Required="false" Mask="false">5432</Config>
  <Config Name="Postgres Database" Target="POSTGRES_DB" Default="fintv" Mode="" Description="Database name" Type="Variable" Display="advanced" Required="false" Mask="false">fintv</Config>
  <Config Name="Postgres User" Target="POSTGRES_USER" Default="fintv" Mode="" Description="Database user" Type="Variable" Display="advanced" Required="false" Mask="false">fintv</Config>
  <Config Name="Postgres Password" Target="POSTGRES_PASSWORD" Default="" Mode="" Description="Database password" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="FFmpeg path" Target="FFMPEG_PATH" Default="/usr/bin/ffmpeg" Mode="" Description="Path to ffmpeg inside the container" Type="Variable" Display="advanced" Required="false" Mask="false">/usr/bin/ffmpeg</Config>
  <Config Name="FFmpeg HWAccel" Target="FFMPEG_HWACCEL" Default="vaapi" Mode="" Description="Set vaapi for Intel Quick Sync encode/decode, or leave empty for software" Type="Variable" Display="advanced" Required="false" Mask="false">vaapi</Config>
  <Config Name="Public URL" Target="CHANNELFLOW_PUBLIC_URL" Default="" Mode="" Description="Public origin for M3U/XMLTV when reverse-proxied, e.g. https://channelflow.example.duckdns.org" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Path base" Target="CHANNELFLOW_PATH_BASE" Default="" Mode="" Description="Only if the UI is under a subpath, e.g. /channelflow" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
</Container>
